<?xml version="1.0" encoding="utf-8"?>
<!-- Allows HTTPS everywhere and cleartext HTTP for user-configured local/LAN AI endpoints (e.g. Ollama). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
